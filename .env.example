# הגדרות ציבוריות לדפדפן
# כל משתנה שמתחיל ב-VITE_ נכלל ביישום ונגיש למשתמשי הדפדפן.
# יש להעתיק את השמות לקובץ .env.local ולהשאיר בקובץ זה ערכי דוגמה ריקים בלבד.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ספק הנתונים הפעיל: local עבור demo מקומי, supabase עבור staging/pilot.
# כאשר נבחר supabase אין fallback לנתוני demo; כל אדמין רואה את סביבת העבודה המשותפת.
VITE_DATA_PROVIDER=local

# סביבת הריצה: development (ברירת מחדל מקומית), staging או production.
# ב-staging וב-production היישום מסרב לעלות עם VITE_DATA_PROVIDER=local,
# כדי שאחסון demo מקומי לעולם לא ישרת נתוני פיילוט אמיתיים.
VITE_APP_ENV=development

# כתובת בסיס ציבורית עתידית לשרת היישום. אינה נדרשת לחיבור Supabase בשלב זה.
VITE_API_BASE_URL=

# סודות שרת בלבד
# אין להוסיף לשמות הבאים VITE_ ואין לשמור אותם בקובצי סביבת ה-frontend.
# הם מוגדרים רק כ-Secrets של Supabase Edge Functions (בלוח הבקרה), לא כאן:
# ELEVENLABS_API_KEY=       # מפתח ElevenLabs, הרשאת ElevenAgents Read+Write
# ELEVENLABS_AGENT_ID=      # מזהה הסוכן הבסיסי (agent_...)
# ELEVENLABS_VOICE_MALE=    # voice id לדמות בקול גברי. ללא ערך הדמות מקבלת את קול הסוכן הבסיסי,
# ELEVENLABS_VOICE_FEMALE=  # voice id לדמות בקול נשי. ולכן לא יישמע הבדל בין דמות גברית לנשית.
# SUPABASE_SERVICE_ROLE_KEY=
